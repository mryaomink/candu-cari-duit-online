rules_version = '2';
service cloud.firestore {
  match /databases/candu/documents {

    // ══ Helper Functions ══════════════════════════════════════════════════════
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    function isParticipant(res) {
      return isAuth() && (
        request.auth.uid == res.data.clientId ||
        request.auth.uid == res.data.creatorId
      );
    }

    function notWritingEmbedding() {
      return !("embedding" in request.resource.data.diff(resource.data).affectedKeys());
    }

    function notWritingBalance() {
      return !("balance" in request.resource.data.diff(resource.data).affectedKeys());
    }

    function validStatus(status) {
      return status in [
        'pending', 'active', 'in_progress',
        'completed', 'disputed', 'cancelled'
      ];
    }

    // ══ /users ════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && notWritingBalance();
                    // balance only modified by Cloud Functions (service account)
      allow delete: if false;
    }

    // ══ /creators ════════════════════════════════════════════════════════════
    match /creators/{creatorId} {
      allow read: if isAuth();
      allow create: if isOwner(creatorId) && !("embedding" in request.resource.data);
      // Only the owner may mutate their own profile (excluding the embedding,
      // which is computed server-side). Aggregate fields like `avgRating` and
      // `totalProjects` are updated exclusively by Cloud Functions running with
      // the service account after a review is verified — never by clients.
      allow update: if 
        (isOwner(creatorId) && (
          !("embedding" in resource.data) ? !("embedding" in request.resource.data) : 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["embedding"])
        )) || 
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["avgRating", "totalProjects", "updatedAt"]));
      allow delete: if isOwner(creatorId) || isAdmin();
    }

    // ══ /reviews ═════════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.reviewerId == request.auth.uid;
      allow update: if isAuth() && resource.data.reviewerId == request.auth.uid;
      allow delete: if false;
    }

    // ══ /projects ════════════════════════════════════════════════════════════
    match /projects/{projectId} {
      allow read: if isParticipant(resource) || isAdmin();
      allow create: if isAuth()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && validStatus(request.resource.data.status);
      allow update: if isParticipant(resource)
                    && validStatus(request.resource.data.status);
      allow delete: if false; // soft-delete via status only
    }

    // ══ /transactions ════════════════════════════════════════════════════════
    match /transactions/{txId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow write: if false; // Cloud Functions service account only
    }

    // ══ /search_queries ══════════════════════════════════════════════════════
    match /search_queries/{queryId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ══ /_logs ═══════════════════════════════════════════════════════════════
    match /_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth(); // Client-side error logger allowed
      allow update, delete: if false;
    }
  }
}
