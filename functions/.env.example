# Copy to `functions/.env.local` for emulator / local dev.
# `.env.local` is gitignored — do NOT commit it.

# Auto-injected by Cloud Run in production; required for emulator.
GOOGLE_CLOUD_PROJECT=endless-memento-495505-f2

# Override only if you need a non-default Vertex AI region.
GOOGLE_CLOUD_LOCATION=global

GOOGLE_GENAI_USE_VERTEXAI=True

# Optional: only set this if you must point to a service-account JSON file
# instead of using `gcloud auth application-default login`. Prefer ADC
# whenever possible — it avoids storing key files on disk.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
