# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Next.js automatically loads `.env.local` for `next dev` and `next build`.
#
# DO NOT commit `.env.local` — it contains secrets.

# ─── Firebase Web SDK (Required) ─────────────────────────────────────────────
# Firebase Console → Project Settings → Your apps → Web app config.
# These are public by design (NEXT_PUBLIC_*) but MUST be locked down with
# Firebase App Check + API key restrictions in Cloud Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Cloudinary (Required for Portfolio Image Uploads) ───────────────────────
# Cloudinary Dashboard → Settings → Access Keys.
# CLOUDINARY_API_KEY/SECRET are server-side only (used by /api/upload).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Development ─────────────────────────────────────────────────────────────
# Set to "true" to use Firebase Local Emulator Suite on localhost.
NEXT_PUBLIC_USE_EMULATOR=false

# ─── Note ────────────────────────────────────────────────────────────────────
# Cloud Functions Vertex AI / Gemini config lives in `functions/.env`
# (and `functions/.env.local` for emulators). The frontend does NOT read
# Vertex AI credentials directly.
