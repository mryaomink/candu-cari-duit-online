# Cloud Functions runtime environment.
#
# This file IS committed and applies to every Firebase project.
# Per-project overrides live in `functions/.env.<project-id>`.
# Local-only overrides (with secrets) live in `functions/.env.local`
# (gitignored). Firebase CLI loads them in this priority order:
#   .env.<project-id>.local  >  .env.local  >  .env.<project-id>  >  .env

# Vertex AI / Gemini Enterprise Agent Platform location.
# `global` is required for current-generation models per docs:
# https://docs.cloud.google.com/gemini-enterprise-agent-platform/models/start
GOOGLE_CLOUD_LOCATION=global

# Tells `@google/genai` SDK to use the Vertex AI backend rather than
# the public Gemini API. The SDK also reads the explicit `vertexai: true`
# option in `new GoogleGenAI({...})`, so this is belt-and-suspenders.
GOOGLE_GENAI_USE_VERTEXAI=True
